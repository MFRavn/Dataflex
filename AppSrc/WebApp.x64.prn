40205>>>>>                Case Break
40206>>>>>
40206>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
40209>>>>>                // If from parent, this is a constrained drill down.
40209>>>>>                Case Break
40210>>>>>
40210>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
40213>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
40213>>>>>                Case Break
40214>>>>>
40214>>>>>            Case Else // must be nfUndefined
40214>>>>>
40214>>>>>        Case End
40214>>>>>
40214>>>>>        Send SetActionButtons
40215>>>>>
40215>>>>>    End_Procedure
40216>>>>>
40216>>>>>End_Object 
