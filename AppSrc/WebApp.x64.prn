39729>>>                //Case Break
39729>>>
39729>>>            //Case Else // must be nfUndefined
39729>>>
39729>>>        Case End
39729>>>        
39729>>>        If (HasRecord(hoDD)) Begin 
39731>>>            // Corregido: Usamos '+' y Trim para una mejor presentación del título
39731>>>            Send SetHeaderCaption ("Jugador: " + Trim(jugador.Nombre) + " " + Trim(jugador.Apellido) + " (" + Trim(equipo.Nombre) + ")")
39732>>>            Send SetBreadcrumbCaption (Trim(jugador.Nombre) + " " + Trim(jugador.Apellido))
39733>>>        End
39733>>>>
